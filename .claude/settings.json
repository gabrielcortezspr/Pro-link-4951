{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/retomar.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Lendo onde o trabalho parou…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hook-padrao.sh\"",
            "timeout": 10,
            "statusMessage": "Conferindo o padrão visual…"
          }
        ]
      }
    ]
  }
}
