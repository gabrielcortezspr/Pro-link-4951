# segredos — nunca versionar
.env
.env.local
.claude/settings.local.json

# dependências
/vendor/
/node_modules/
/e2e/node_modules/

# saída da suíte de ponta a ponta: vídeo, rastro e relatório são reproduzíveis rodando de novo,
# e binário de megabytes no histórico só engorda o .zip que a entrega manda subir (8.7).
/e2e/resultados/
/e2e/relatorio/
/e2e/videos/

# Certificado HTTPS local (D81). A chave privada NUNCA é versionada (Anexo VI): cada máquina gera
# a sua com scripts/gerar-certificado-local.sh. Só o .gitkeep fica, para a pasta existir no clone.
/docker/nginx/certs/*
!/docker/nginx/certs/.gitkeep
*.key
*.pem

# ambiente
.DS_Store
*.log
/docker/data/

# python (scripts de apoio)
__pycache__/
*.pyc
.venv/
venv/

# runtime
/storage/cache/*
/storage/logs/*
!/storage/*/.gitkeep

# O pacote da entrega é gerado por scripts/empacotar-entrega.sh, e não se versiona.
entrega/

# Credencial local da suíte de ponta a ponta. Nunca versionada (Anexo VI, item 5).
e2e/.env.local

# Os vídeos são gerados pela suíte (e2e/rodar.sh) e pesam dezenas de MB: ficam fora do
# repositório, e o README da pasta diz como refazê-los.
e2e/videos/
