{
  "name": "equipe-49-51/pro-link",
  "description": "Pro-Link — plataforma de compatibilização entre demandas técnicas e profissionais registrados no CREA-AM. Desafio CREA Pro-Link, II CENATEC 2026.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "twig/twig": "^3.8",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "ProLink\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ProLink\\Tests\\": "tests/" }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
