# Copie para .env e preencha. O .env NUNCA vai para o controle de versão.
# Edital, item 8.3.1: chaves, tokens e credenciais ficam em variáveis de ambiente.

# Ambiente: dev | homolog | prod
APP_ENV=dev
# Desligado por padrão de propósito. O README manda copiar este arquivo, e com APP_DEBUG=true a
# resposta de erro carrega a mensagem da exceção (public/index.php) — quem avalia a entrega não
# deve ver stack de aplicação. Ligue enquanto desenvolve; desligue antes de mostrar a alguém.
APP_DEBUG=false
# HTTPS desde a D81: a página é servida na 8443, e CSS, JS e formulários são montados a partir
# daqui. Com http://localhost:8080 a CSP ('self') bloqueia tudo e a tela abre sem estilo e sem login.
APP_URL=https://localhost:8443
APP_TIMEZONE=America/Manaus

# Chave de 32 bytes em base64, usada na cifragem AES-256 de CPF/CNPJ em repouso.
# Gere com: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Banco (os mesmos valores alimentam o serviço mariadb do docker-compose)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=prolink
DB_USERNAME=prolink
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Usuário da aplicação, com menor privilégio (D82): SELECT/INSERT/UPDATE por tabela, só
# SELECT/INSERT na auditoria, sem DELETE e sem estrutura. Criado na primeira subida do banco por
# _arq/usuarios.sh. As requisições web usam este; DB_USERNAME acima é o administrativo, usado por
# migração, povoamento e verificadores na linha de comando. Senha diferente das outras duas.
DB_APP_USERNAME=prolink_app
DB_APP_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# API oficial do desafio (token individual da equipe, obtido na plataforma)
PROLINK_API_BASE=https://desafio-prolink.crea-am.org.br/api/v1/
PROLINK_API_TOKEN=
PROLINK_API_TIMEOUT=30

# SMTP (RF07). Em desenvolvimento o destino é o Mailpit do docker-compose:
# MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_ENCRYPTION=none.
#
# Atenção: deixar MAIL_ENCRYPTION vazio NÃO desliga o TLS. env() trata string vazia como ausente
# e devolve o padrão 'tls'; o Mailpit então responde "STARTTLS command not implemented" e todo
# envio falha. Para desligar, escreva um valor que não seja tls nem ssl — use 'none'.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@prolink.local
MAIL_FROM_NAME="Pro-Link"

# Teto de retentativa por notificação: passou disso, a fila desiste e guarda o erro em not_erro,
# em vez de reencenar a mesma falha permanente em toda execução.
MAIL_MAX_TENTATIVAS=3

# Quantas saem a cada requisição no despacho pós-resposta. Pequeno de propósito: a resposta já foi
# ao navegador, mas o processo do php-fpm segue ocupado até o lote terminar.
MAIL_LOTE_POS_RESPOSTA=5

# Sessão, senha e força bruta (RF01, OWASP A07)
SESSION_LIFETIME_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SENHA_TAMANHO_MINIMO=12
RECUPERACAO_VALIDADE_MINUTOS=60
