{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}
{% import 'layout/_ui.html.twig' as ui %}

{% block titulo %}Nova demanda · Pro-Link{% endblock %}

{#  Tela de dentro da conta: shell de barra lateral (layout/base.html.twig). #}
{% set shell = 'app' %}
{% set ativo = 'demandas' %}
{% set medida = 'leitura' %}

{% block titulo_tela %}Nova demanda{% endblock %}

{#  Formulário: medida de leitura, não largura de tabela. O card é o objeto da tela, e a moldura
    ao redor dele é intencional, do mesmo jeito que no palco do feed. #}
{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
{#  `ufs_possiveis` é lista simples e a macro `selecao` espera mapa chave => rótulo. A chave aqui
    é a própria sigla, que é string: `merge` só renumera chave inteira, então a armadilha do
    <select> de ART (ver perfil/index) não se aplica. #}
{% set ufs_mapa = ufs_possiveis|reduce((mapa, uf) => mapa|merge({(uf): uf}), {}) %}

<div class="pl-head">
    <div class="tit">
        <div class="pl-linha-titulo">
            <h1>Nova demanda</h1>
            {{ ui.info('Por que a demanda nasce rascunho',
                'Salvar cria o rascunho, que só você enxerga. A publicação é um segundo passo porque antes dela é preciso escolher as atividades da Tabela de Obras e Serviços: é por elas que a plataforma encontra quem já comprovou fazer este tipo de serviço.') }}
        </div>
    </div>
</div>

{% if aviso is defined and aviso %}
    <div class="alert alert-danger" role="alert">{{ aviso }}</div>
{% endif %}

<form method="post" action="{{ app_url }}/demandas" class="pl-card">
    {{ form.csrf() }}

    {{ form.campo('titulo', 'Título', 'text', valores.titulo|default(''),
        erros.titulo|default(null), {required: true},
        'Uma linha. Ex.: Reforma estrutural da fachada do bloco A.') }}

    {{ form.area('escopo', 'O que precisa ser feito', valores.escopo|default(''),
        erros.escopo|default(null), {required: true, rows: 6}) }}

    <div class="row">
        <div class="col-sm-8">
            {{ form.campo('local_municipio', 'Município', 'text',
                valores.local_municipio|default(''), erros.local_municipio|default(null)) }}
        </div>
        <div class="col-sm-4">
            {#  Lista fechada dos dois lados: é a UF daqui que o motor compara com a abrangência
                declarada pelo candidato. Texto livre nunca casava. #}
            {{ form.selecao('local_uf', 'UF', ufs_mapa, valores.local_uf|default(''),
                erros.local_uf|default(null), {}, 'Não informada') }}
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            {{ form.selecao('tipo_contrato', 'Tipo de contrato', contratos_possiveis,
                valores.tipo_contrato|default(''), erros.tipo_contrato|default(null), {}, 'A combinar') }}
        </div>
        <div class="col-sm-6">
            {{ form.selecao('alvo', 'Quem pode atender', {
                'A': 'Profissionais e empresas',
                'P': 'Somente profissionais',
                'E': 'Somente empresas'
            }, valores.alvo|default('A'), erros.alvo|default(null), {required: true}, false) }}
        </div>
    </div>

    <div class="pl-acoes-form">
        {{ form.botao('Salvar rascunho') }}
        <a class="pl-btn ghost" href="{{ app_url }}/demandas">Cancelar</a>
    </div>
</form>
{% endblock %}
