{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}

{% block titulo %}Nova demanda · Pro-Link{% endblock %}

{% block conteudo %}
<h1 class="h3 mb-1">Nova demanda</h1>
<p class="text-body-secondary">
    A demanda nasce como rascunho. Depois de salvar você escolhe os códigos da Tabela de Obras e
    Serviços: é por eles que a plataforma encontra quem já comprovou fazer este tipo de serviço.
</p>

{% if aviso is defined and aviso %}
    <div class="alert alert-danger" role="alert">{{ aviso }}</div>
{% endif %}

<form method="post" action="{{ app_url }}/demandas" class="col-lg-8">
    {{ form.csrf() }}

    {{ form.campo('titulo', 'Título', 'text', valores.titulo|default(''),
        erros.titulo|default(null), {required: true},
        'Uma linha. Ex.: Reforma estrutural da fachada do bloco A.') }}

    {{ form.area('escopo', 'O que precisa ser feito', valores.escopo|default(''),
        erros.escopo|default(null), {required: true, rows: 6}) }}

    <div class="row">
        <div class="col-sm-8">
            {{ form.campo('local_municipio', 'Município', 'text',
                valores.local_municipio|default(''), erros.local_municipio|default(null)) }}
        </div>
        <div class="col-sm-4">
            {{ form.campo('local_uf', 'UF', 'text', valores.local_uf|default(''),
                erros.local_uf|default(null), {maxlength: 2}) }}
        </div>
    </div>

    {{ form.campo('tipo_contrato', 'Tipo de contrato', 'text',
        valores.tipo_contrato|default(''), erros.tipo_contrato|default(null), {},
        'Ex.: CLT, PJ, obra certa. Opcional.') }}

    {{ form.selecao('alvo', 'Quem pode atender', {
        'A': 'Profissionais e empresas',
        'P': 'Somente profissionais',
        'E': 'Somente empresas'
    }, valores.alvo|default('A'), erros.alvo|default(null), {required: true}, false) }}

    {{ form.botao('Salvar rascunho') }}
    <a class="btn btn-link" href="{{ app_url }}/demandas">Cancelar</a>
</form>
{% endblock %}
