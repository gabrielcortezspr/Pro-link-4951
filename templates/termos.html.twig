{% extends 'layout/base.html.twig' %}

{% block titulo %}{{ titulo }} · Pro-Link{% endblock %}

{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
<div class="pl-head">
    <div class="tit">
        <h1>{{ titulo }}</h1>
        <p class="sub">
            <span>Versão <span class="n">{{ termo.ter_versao }}</span></span>
            <span class="pl-sep" aria-hidden="true"></span>
            <span>em vigor desde {{ termo.ter_dt_vigencia|date('d/m/Y') }}</span>
        </p>
    </div>
</div>

<div class="pl-card">
    <div class="pl-legal">{{ termo.ter_conteudo|nl2br }}</div>
</div>
{% endblock %}
