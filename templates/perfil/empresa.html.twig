{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}
{% import 'layout/_ui.html.twig' as ui %}

{% block titulo %}{{ titulo }} · Pro-Link{% endblock %}

{#  Tela de dentro da conta: shell de barra lateral (layout/base.html.twig). #}
{% set shell = perfil.eh_dono ? 'app' : '' %}
{% set ativo = 'perfil' %}
{% set medida = 'registro' %}

{% block titulo_tela %}Meu perfil{% endblock %}

{% block classe_main %}pl-wrap registro{% endblock %}

{% block conteudo %}
{% set p = perfil %}
{% set n_arts = p.arts|length %}
{% set n_vigentes = p.quadro|filter(m => m.vigente)|length %}

{#  ------------------------------------------------------------------ a identidade

    O mesmo retrato do perfil do profissional (docs/mockups/prolink-early-career.html, telas 02 e
    03), com o que muda de verdade entre pessoa física e jurídica: a empresa não tem RNP, e o
    acervo dela é herdado do quadro técnico em vez de registrado em nome próprio. Vocabulário da
    seção 13 do prolink.css, o mesmo do feed: retrato tem um desenho só na plataforma. #}
<section class="pl-card pl-perfil-id">
    <div class="pl-topo">
        <span class="pl-av" aria-hidden="true">{{ ui.iniciais(p.identidade.razao_social) }}</span>

        <div class="pl-ident">
            <h1 class="pl-name">
                {{ p.identidade.razao_social }}
                {% if p.identidade.registro_crea %}
                    <svg class="pl-seal" role="img" aria-label="Registro conferido na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                {% endif %}
            </h1>

            <p class="pl-meta">
                {% if p.identidade.nome_fantasia %}
                    <span>{{ p.identidade.nome_fantasia }}</span>
                    <span aria-hidden="true">·</span>
                {% endif %}
                <span>Empresa</span>
                {% if p.identidade.registro_crea %}
                    <span aria-hidden="true">·</span>
                    <span>Registro no CREA <span class="mono">{{ p.identidade.registro_crea }}</span></span>
                {% else %}
                    <span aria-hidden="true">·</span>
                    <span>Registro no CREA ainda não validado</span>
                {% endif %}
            </p>

            {#  A linha de acervo. O selo verde água só acompanha afirmação sustentada por
                documento: com a certidão vazia ele afirmaria o contrário do texto. #}
            <p class="pl-acervo">
                {% if n_arts > 0 %}
                    <svg class="pl-mark" role="img" aria-label="Conferidas na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                    {{ n_arts }} {{ n_arts == 1 ? 'ART na Certidão de Acervo Operacional' : 'ARTs na Certidão de Acervo Operacional' }}
                {% else %}
                    <svg class="pl-mark nao" role="img" aria-label="Sem ART na certidão"><use href="#pl-sym-seal-x"/></svg>
                    Nenhuma ART na Certidão de Acervo Operacional
                {% endif %}
                {% if n_vigentes > 0 %}
                    <span aria-hidden="true">·</span>
                    <span>{{ n_vigentes }} {{ n_vigentes == 1 ? 'vínculo vigente no quadro técnico' : 'vínculos vigentes no quadro técnico' }}</span>
                {% endif %}
            </p>
        </div>

        <div class="pl-perfil-est">
            {#  "Perfil visível" e não "Perfil público": cada item tem o seu nível e o padrão de
                todos é "Só eu", então perfil aberto quer dizer consentimento de pé e registro
                regular, não que algo esteja público. #}
            {% if p.eh_dono %}
                {% if p.perfil_aberto %}
                    <span class="pl-pill ok" title="O consentimento de exibição está de pé e o registro está regular. O que cada pessoa enxerga continua sendo o que você escolheu item a item.">
                        <span class="pd" aria-hidden="true"></span>Perfil visível
                    </span>
                {% else %}
                    <span class="pl-pill neutral" title="Ninguém além de você enxerga este perfil agora.">
                        <span class="pd" aria-hidden="true"></span>Perfil fechado
                    </span>
                {% endif %}
            {% elseif p.identidade.registro_crea %}
                <span class="pl-pill ok" title="Registro conferido na API oficial do CREA-AM.">
                    <span class="pd" aria-hidden="true"></span>Registro ativo
                </span>
            {% endif %}
        </div>
    </div>
</section>

{#  Como se lê esta página, em uma linha: o que o conselho confirma e o que a empresa escreve
    nunca se confundem. As duas marcas da legenda são as mesmas que aparecem nos blocos. #}
<p class="pl-legenda-selo">
    <span>
        <svg class="pl-mark" aria-hidden="true"><use href="#pl-sym-seal"/></svg>
        Verificado na API oficial do CREA-AM
    </span>
    <span>
        <svg class="pl-mark nao" aria-hidden="true"><use href="#pl-sym-seal-x"/></svg>
        Declarado pela empresa, sem verificação da plataforma
    </span>
</p>

{% if p.eh_dono and p.validacao_pendente %}
    <div class="alert alert-warning d-flex flex-wrap gap-3 align-items-center" role="alert">
        <div class="flex-grow-1">
            <strong>O registro da empresa no CREA ainda não foi validado.</strong>
            A API oficial não respondeu quando a conta foi criada. Enquanto isso, o perfil não
            aparece para ninguém.
        </div>
        <form method="post" action="{{ app_url }}/perfil/validar-registro">
            {{ form.csrf() }}
            <button type="submit" class="btn btn-warning">Validar o registro</button>
        </form>
    </div>
{% elseif p.sincronizacao_incompleta %}
    <div class="alert alert-warning d-flex flex-wrap gap-3 align-items-center" role="alert">
        <div class="flex-grow-1">
            <strong>O quadro técnico e o acervo não foram importados.</strong>
            O registro está validado, mas não conseguimos ler a Certidão de Acervo Operacional.
        </div>
        <form method="post" action="{{ app_url }}/perfil/validar-registro">
            {{ form.csrf() }}
            <button type="submit" class="btn btn-warning">Importar quadro técnico e acervo</button>
        </form>
    </div>
{% endif %}

{% if p.eh_dono and not p.perfil_aberto %}
    <div class="alert alert-secondary" role="alert">
        <strong>O perfil da empresa está fechado.</strong>
        Ninguém além de você o enxerga, mesmo o que estiver marcado como público. Isso acontece
        quando o consentimento de exibição está revogado
        (<a href="{{ app_url }}/privacidade">painel de privacidade</a>)
        ou enquanto o registro no CREA não estiver validado.
    </div>
{% endif %}

<div class="pl-cols">
    <div class="pl-stack">

        <section class="pl-card">
            <div class="pl-linha-titulo">
                <h2 class="pl-secao">Acervo operacional</h2>
                {{ ui.info('De onde vem este acervo',
                    'A empresa não registra ART. O acervo operacional é o das ARTs registradas pelos profissionais do quadro técnico, e a empresa responde por elas enquanto o vínculo estiver vigente. Vínculo encerrado não herda nada.') }}
                {% if p.arts is not empty %}
                    <span class="cnt">{{ n_arts }} {{ n_arts == 1 ? 'ART na Certidão de Acervo Operacional' : 'ARTs na Certidão de Acervo Operacional' }}</span>
                {% endif %}
            </div>

            {#  Certidão vazia é estado legítimo e sinalizado, nunca escondido. Para o dono o
                quadro traz a saída; para quem visita, o mesmo fato sem adjetivo. #}
            {% if p.arts is empty %}
                <div class="pl-vazio">
                    <p class="t">Nenhuma ART no acervo ainda</p>
                    <p class="s">
                        {% if p.eh_dono %}
                            O acervo operacional é lido da Certidão de Acervo Operacional na API
                            oficial do CREA-AM, e não é preenchido à mão. Ele começa a existir
                            quando houver vínculo vigente com profissional que tenha ART
                            registrada.
                        {% else %}
                            Esta empresa ainda não tem ART herdada do quadro técnico, ou escolheu
                            não exibir nenhuma.
                        {% endif %}
                    </p>
                    {% if p.eh_dono %}
                        <form class="a" method="post" action="{{ app_url }}/perfil/validar-registro">
                            {{ form.csrf() }}
                            <button type="submit" class="pl-btn">Importar quadro técnico e acervo</button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                {% for art in p.arts %}
                    {{ ui.art(art, {nome: art.profissional, rnp: art.rnp}) }}
                {% endfor %}
            {% endif %}
        </section>
    </div>

    <div class="pl-stack">
        {#  Painel de controle do titular. Sem a guarda, quem abre /perfil/{id} de outra empresa
            veria um formulário que mudaria a visibilidade da própria conta ao ser enviado. #}
        {% if p.eh_dono %}
            <section class="pl-card">
                <div class="pl-linha-titulo">
                    <h2 class="pl-secao">Quem vê o quê</h2>
                    {{ ui.info('Como a visibilidade funciona',
                        'Cada item tem o seu próprio nível, e o padrão de todos é "Só eu". A escolha é conferida toda vez que alguém lê o perfil, inclusive na compatibilização: um documento fechado continua sustentando a aderência sem ser identificado.', 'fim') }}
                </div>
                <p class="pl-nota">Nada fica visível sem você escolher. O padrão de tudo é <strong>Só eu</strong>.</p>

                {#  A linha do mockup (tela 03 de prolink-profissional.html): o item à esquerda, com
                    uma segunda linha dizendo o que ele é, e o controle à direita. O interruptor do
                    mockup tem duas posições e o nível tem três, então o controle continua sendo o
                    <select>, escrito à mão para caber a segunda linha. O par `for`/`id` continua
                    ligado e a descrição entra por aria-describedby. #}
                {#  Descrição curta de propósito: a coluna do painel tem pouco mais de 160px, e
                    frase longa aqui é frase cortada com reticências. #}
                {% set descricao_do_campo = {
                    'EMAIL':    'Contato da conta',
                    'TELEFONE': 'Contato da conta',
                    'RESUMO':   'Texto escrito pela empresa'
                } %}

                <form method="post" action="{{ app_url }}/perfil/visibilidade">
                    {{ form.csrf() }}

                    <fieldset class="pl-vis">
                        <legend class="pl-legenda">Dados do perfil</legend>
                        {% for campo in p.campos_do_perfil %}
                            {% set chave = 'PERFIL:-:' ~ campo %}
                            {% set id = 'vis-campo-' ~ loop.index %}
                            <div class="ln">
                                <div class="tx">
                                    <label class="vt" for="{{ id }}">{{ campo|rotulo_campo }}</label>
                                    <span class="vs" id="{{ id }}-ajuda">{{ descricao_do_campo[campo]|default('Dado do perfil da empresa') }}</span>
                                </div>
                                <select class="form-select" name="nivel[{{ chave }}]" id="{{ id }}"
                                        aria-describedby="{{ id }}-ajuda">
                                    {% for valor, texto in niveis_possiveis %}
                                        <option value="{{ valor }}"{% if p.niveis[chave]|default('PRIVADO') == valor %} selected{% endif %}>{{ texto }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endfor %}
                    </fieldset>

                    {% if p.arts is not empty %}
                        <fieldset class="pl-vis">
                            <legend class="pl-legenda">Cada ART do acervo, uma a uma</legend>
                            {% for art in p.arts %}
                                {% set chave = 'ART:' ~ art.id ~ ':-' %}
                                {% set id = 'vis-art-' ~ art.id %}
                                <div class="ln">
                                    <div class="tx">
                                        <label class="vt unidade" for="{{ id }}">
                                            ART {{ art.numero }}
                                            {% if art.selo_confere %}
                                                <svg class="pl-mark" role="img" aria-label="Conferida na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                                            {% endif %}
                                        </label>
                                        <span class="vs" id="{{ id }}-ajuda">{{ art.objeto }}{% if art.contratante %} · {{ art.contratante }}{% endif %}</span>
                                    </div>
                                    <select class="form-select" name="nivel[{{ chave }}]" id="{{ id }}"
                                            aria-describedby="{{ id }}-ajuda">
                                        {% for valor, texto in niveis_possiveis %}
                                            <option value="{{ valor }}"{% if p.niveis[chave]|default('PRIVADO') == valor %} selected{% endif %}>{{ texto }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endfor %}
                        </fieldset>
                    {% endif %}

                    <div class="pl-acoes-form">{{ form.botao('Salvar visibilidade') }}</div>
                </form>
            </section>
        {% endif %}

        <section class="pl-card">
            <div class="pl-linha-titulo">
                <h2 class="pl-secao">Quadro técnico</h2>
                {{ ui.info('O que o vínculo muda',
                    'Só o vínculo vigente transfere acervo para a empresa. Vínculo encerrado não herda nada, e a API não data a ART, então não há recorte por período.', 'fim') }}
                {% if p.quadro is not empty %}<span class="cnt">{{ p.quadro|length }}</span>{% endif %}
            </div>

            {% if p.quadro is empty %}
                <p class="pl-nota mb-0">Nenhum vínculo importado da API.</p>
            {% else %}
                <ul class="pl-quadro">
                    {% for membro in p.quadro %}
                        <li>
                            <div class="id">
                                <span class="nm">{{ membro.nome ?: 'Sem nome na API' }}</span>
                                <span class="pl-mono">RNP {{ membro.rnp }}</span>
                            </div>
                            <div class="fn">
                                {# qut_funcao é texto livre e qut_tipo é o campo estruturado. Quando a
                                   API manda os dois, o texto já diz o que a marca diria — repetir só
                                   ocuparia a linha. A marca aparece quando é o único que informa. #}
                                {% if membro.funcao %}
                                    {{ membro.funcao }}
                                {% elseif membro.responsavel %}
                                    Responsável técnico
                                {% else %}
                                    Sem função informada
                                {% endif %}
                            </div>
                            {% if membro.vigente %}
                                <span class="pl-pill ok" title="Vínculo vigente: o acervo deste profissional conta para a empresa.">
                                    <span class="pd" aria-hidden="true"></span>Vínculo vigente
                                </span>
                            {% else %}
                                <span class="pl-pill neutral" title="Vínculo encerrado: o acervo deste profissional não conta para a empresa.">
                                    <span class="pd" aria-hidden="true"></span>Encerrado em {{ membro.dt_fim }}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
