{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}
{% import 'layout/_ui.html.twig' as ui %}

{% block titulo %}{{ titulo }} · Pro-Link{% endblock %}

{#  Tela de dentro da conta: shell de barra lateral (layout/base.html.twig). #}
{% set shell = perfil.eh_dono ? 'app' : '' %}
{% set ativo = 'perfil' %}
{% set medida = 'registro' %}

{% block titulo_tela %}Meu perfil{% endblock %}

{% block classe_main %}pl-wrap registro{% endblock %}

{% block conteudo %}
{% set p = perfil %}
{% set n_arts = p.arts|length %}
{#  A certidão de cada ART herdada (D76). A empresa não tem CAT própria: a de cada ART é a do
    profissional que a registrou, e só existe na plataforma se ele tiver conta aqui. A contagem
    mora no macro `cat_resumo`; aqui só se sabe se ALGUMA ART tem certidão, para o aviso do painel
    de privacidade. #}
{% set tem_cat = p.arts|filter(a => a.cats|default([]) is not empty)|length > 0 %}
{% set n_quadro = p.quadro|length %}
{% set n_vigentes = p.quadro|filter(m => m.vigente)|length %}

{#  ------------------------------------------------------------------ a identidade

    O mesmo retrato do perfil do profissional (docs/mockups/prolink-early-career.html, telas 02 e
    03), com o que muda de verdade entre pessoa física e jurídica: a empresa não tem RNP, e o
    acervo dela é herdado do quadro técnico em vez de registrado em nome próprio. Vocabulário da
    seção 13 do prolink.css, o mesmo do feed: retrato tem um desenho só na plataforma. #}
<section class="pl-card pl-perfil-id">
    <div class="pl-topo">
        <span class="pl-av" aria-hidden="true">{{ ui.iniciais(p.identidade.razao_social) }}</span>

        <div class="pl-ident">
            <h1 class="pl-name">
                {{ p.identidade.razao_social }}
                {% if p.identidade.registro_crea %}
                    <svg class="pl-seal" role="img" aria-label="Registro conferido na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                {% endif %}
            </h1>

            <p class="pl-meta">
                {% if p.identidade.nome_fantasia %}
                    <span>{{ p.identidade.nome_fantasia }}</span>
                    <span aria-hidden="true">·</span>
                {% endif %}
                <span>Empresa</span>
                {% if p.identidade.registro_crea %}
                    <span aria-hidden="true">·</span>
                    <span>Registro no CREA <span class="mono">{{ p.identidade.registro_crea }}</span></span>
                {% else %}
                    <span aria-hidden="true">·</span>
                    <span>Registro no CREA ainda não validado</span>
                {% endif %}
            </p>

            {#  A linha de acervo. O selo verde água só acompanha afirmação sustentada por
                documento: com a certidão vazia ele afirmaria o contrário do texto. #}
            {#  Uma frase só, num <span> só, com o vínculo dentro: em 390px a contagem e o vínculo
                como dois itens do flex dividiam a linha, e a contagem virava uma coluna de uma
                palavra por linha. #}
            <p class="pl-acervo">
                {% if n_arts > 0 %}
                    <svg class="pl-mark" role="img" aria-label="Conferidas na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                {% else %}
                    <svg class="pl-mark nao" role="img" aria-label="Sem ART na certidão"><use href="#pl-sym-seal-x"/></svg>
                {% endif %}
                <span class="qt">
                    {% if n_arts > 0 %}
                        {{- n_arts }} {{ n_arts == 1 ? 'ART na Certidão de Acervo Operacional' : 'ARTs na Certidão de Acervo Operacional' }}
                        {{- ui.cat_resumo(p.arts) }}
                    {%- else -%}
                        Nenhuma ART na Certidão de Acervo Operacional
                    {%- endif -%}
                    {%- if n_vigentes > 0 %} · {{ n_vigentes }} {{ n_vigentes == 1 ? 'vínculo vigente no quadro técnico' : 'vínculos vigentes no quadro técnico' }}{% endif %}
                </span>
            </p>
        </div>

        <div class="pl-perfil-est">
            {#  "Perfil visível" e não "Perfil público": cada item tem o seu nível e o padrão de
                todos é "Só eu", então perfil aberto quer dizer consentimento de pé e registro
                regular, não que algo esteja público. #}
            {% if p.eh_dono %}
                {% if p.perfil_aberto %}
                    <span class="pl-pill ok" title="O consentimento de exibição está de pé e o registro está regular. O que cada pessoa enxerga continua sendo o que você escolheu item a item.">
                        <span class="pd" aria-hidden="true"></span>Perfil visível
                    </span>
                {% else %}
                    <span class="pl-pill neutral" title="Ninguém além de você enxerga este perfil agora.">
                        <span class="pd" aria-hidden="true"></span>Perfil fechado
                    </span>
                {% endif %}
            {% elseif p.identidade.registro_crea %}
                <span class="pl-pill ok" title="Registro conferido na API oficial do CREA-AM.">
                    <span class="pd" aria-hidden="true"></span>Registro ativo
                </span>
            {% endif %}

            {#  Denunciar, para quem tem conta e não é o dono (D84). Discreto e depois do selo:
                o fato de registro vem primeiro, a ação de exceção fica no canto. #}
            {{ ui.denunciar('USUARIO', p.usuario_id, 'esta empresa', p.eh_dono) }}
        </div>
    </div>
</section>

{#  Como se lê esta página, em uma linha: o que o conselho confirma e o que a empresa escreve
    nunca se confundem. Fica fora das abas, como no perfil do profissional: a distinção vale em
    todas elas. As duas marcas da legenda são as mesmas que aparecem nos blocos. #}
<p class="pl-legenda-selo">
    <span>
        <svg class="pl-mark" aria-hidden="true"><use href="#pl-sym-seal"/></svg>
        Verificado na API oficial do CREA-AM
    </span>
    <span>
        <svg class="pl-mark nao" aria-hidden="true"><use href="#pl-sym-seal-x"/></svg>
        Declarado pela empresa, sem verificação da plataforma
    </span>
</p>

{% if p.eh_dono and p.validacao_pendente %}
    <div class="alert alert-warning d-flex flex-wrap gap-3 align-items-center" role="alert">
        <div class="flex-grow-1">
            <strong>O registro da empresa no CREA ainda não foi validado.</strong>
            A API oficial não respondeu quando a conta foi criada. Enquanto isso, o perfil não
            aparece para ninguém.
        </div>
        {{ ui.atualizar_acervo('Validar o registro', atualizacao|default(null), 'alerta') }}
    </div>
{% elseif p.sincronizacao_incompleta %}
    <div class="alert alert-warning d-flex flex-wrap gap-3 align-items-center" role="alert">
        <div class="flex-grow-1">
            <strong>O quadro técnico e o acervo não foram importados.</strong>
            O registro está validado, mas não conseguimos ler a Certidão de Acervo Operacional.
        </div>
        {{ ui.atualizar_acervo('Importar quadro técnico e acervo', atualizacao|default(null), 'alerta') }}
    </div>
{% endif %}

{% if p.eh_dono and not p.perfil_aberto %}
    <div class="alert alert-secondary" role="alert">
        <strong>O perfil da empresa está fechado.</strong>
        Ninguém além de você o enxerga, mesmo o que estiver marcado como público. Isso acontece
        quando o consentimento de exibição está revogado
        (<a href="{{ app_url }}/privacidade">painel de privacidade</a>)
        ou enquanto o registro no CREA não estiver validado.
    </div>
{% endif %}

{#  ------------------------------------------------------------------ as abas do perfil

    As mesmas abas do perfil do profissional (seção 38 do prolink.css), com os assuntos que a
    empresa tem: o acervo herdado, o quadro que o herda, e o controle do titular. Endereço próprio
    por aba: /perfil#acervo, /perfil#quadro, /perfil#privacidade. O painel abre por `:target` em
    CSS puro, e `perfil-abas.js` acrescenta por cima o que o CSS não entrega. #}
{% set abas = [
    {id: 'acervo', rotulo: 'Acervo operacional', cnt: n_arts},
    {id: 'quadro', rotulo: 'Quadro técnico',     cnt: n_quadro}
] %}
{% if p.eh_dono %}
    {% set abas = abas|merge([{id: 'privacidade', rotulo: 'Privacidade', cnt: null}]) %}
{% endif %}

<div class="pl-seg-area">
    <nav class="pl-seg" aria-label="Seções do perfil">
        {% for aba in abas %}
            <a class="pl-seg-b" href="#{{ aba.id }}">
                {{ aba.rotulo }}
                {% if aba.cnt is not null %}<span class="n">{{ aba.cnt }}</span>{% endif %}
            </a>
        {% endfor %}
    </nav>

    {# ---------------------------------------------------------------- aba 1: o acervo herdado #}
    <div class="pl-seg-painel padrao" id="acervo">
        {#  O acervo herdado, por profissional do quadro e, dentro de cada um, por certidão
            (`acervo_por_certidao` em layout/_ui.html.twig). A CAT é sempre do profissional, então
            é por ele que a leitura começa: um rótulo por pessoa, e os blocos dela embaixo. Rótulo,
            e não card: um card por pessoa com cards de certidão dentro seria card dentro de card.
            Dentro do grupo da pessoa o "Registrada por" de cada ART sai, porque o rótulo já diz
            de quem ela é. #}
        <div class="pl-stack">
            <div class="pl-linha-titulo pl-acervo-topo">
                <h2 class="pl-secao">Acervo operacional</h2>
                {% if p.arts is not empty %}
                    <span class="cnt">
                        {{- n_arts }} {{ n_arts == 1 ? 'ART na Certidão de Acervo Operacional' : 'ARTs na Certidão de Acervo Operacional' }}
                        {{- ui.cat_resumo(p.arts) -}}
                    </span>
                {% endif %}
                {{ ui.info('De onde vem este acervo',
                    'A empresa não registra ART. O acervo operacional é o das ARTs registradas pelos profissionais do quadro técnico, e a empresa responde por elas enquanto o vínculo estiver vigente. Vínculo encerrado não herda nada. A Certidão de Acervo Técnico (CAT) de cada ART é a do profissional que a registrou, e aparece aqui quando ele tem conta na plataforma.') }}
                {% if p.eh_dono and p.arts is not empty %}
                    {{ ui.atualizar_acervo('Atualizar o acervo no CREA', atualizacao|default(null)) }}
                {% endif %}
            </div>

            {#  Certidão vazia é estado legítimo e sinalizado, nunca escondido. Para o dono o
                quadro traz a saída; para quem visita, o mesmo fato sem adjetivo. #}
            {% if p.arts is empty %}
                <section class="pl-card">
                    <div class="pl-vazio">
                        <p class="t">Nenhuma ART no acervo ainda</p>
                        <p class="s">
                            {% if p.eh_dono %}
                                O acervo operacional é lido da Certidão de Acervo Operacional na API
                                oficial do CREA-AM, e não é preenchido à mão. Ele começa a existir
                                quando houver vínculo vigente com profissional que tenha ART
                                registrada.
                            {% else %}
                                Esta empresa ainda não tem ART herdada do quadro técnico, ou escolheu
                                não exibir nenhuma.
                            {% endif %}
                        </p>
                        {% if p.eh_dono %}
                            {{ ui.atualizar_acervo('Importar quadro técnico e acervo', atualizacao|default(null), 'a') }}
                        {% endif %}
                    </div>
                </section>
            {% else %}
                {#  As pessoas na ordem em que as ARTs chegam. O RNP é a chave: o nome pode faltar
                    na API, e dois homônimos no mesmo quadro não podem virar um grupo só. #}
                {%- set rnps = [] -%}
                {%- for art in p.arts %}{% if art.rnp not in rnps %}{% set rnps = rnps|merge([art.rnp]) %}{% endif %}{% endfor -%}
                {% for rnp in rnps %}
                    {%- set dela = p.arts|filter(a => a.rnp == rnp) -%}
                    {%- set n_dela = dela|length -%}
                    <div class="pl-cert-pessoa">
                        <span class="nm">{{ (dela|first).profissional ? (dela|first).profissional|nome_proprio : 'Profissional do quadro técnico' }}</span>
                        <span class="pl-mono">RNP {{ rnp }}</span>
                        <span class="qt">{{ n_dela }} {{ n_dela == 1 ? 'ART no acervo da empresa' : 'ARTs no acervo da empresa' }}</span>
                    </div>
                    {{ ui.acervo_por_certidao(dela, 'p' ~ rnp ~ '-', p.eh_dono ? 'empresa' : 'visita', rnps|length == 1) }}
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {# ---------------------------------------------------------------- aba 2: o quadro técnico #}
    <div class="pl-seg-painel" id="quadro">
        <section class="pl-card">
            <div class="pl-linha-titulo">
                <h2 class="pl-secao">Quadro técnico</h2>
                {% if p.quadro is not empty %}
                    <span class="cnt">{{ n_vigentes }} de {{ n_quadro }} {{ n_vigentes == 1 ? 'vínculo vigente' : 'vínculos vigentes' }}</span>
                {% endif %}
                {{ ui.info('O que o vínculo muda',
                    'Só o vínculo vigente transfere acervo para a empresa. Vínculo encerrado não herda nada, e a API não data a ART, então não há recorte por período.') }}
            </div>

            {% if p.quadro is empty %}
                <p class="pl-nota mb-0">Nenhum vínculo importado da API.</p>
            {% else %}
                <ul class="pl-quadro">
                    {% for membro in p.quadro %}
                        <li>
                            <div class="id">
                                <span class="nm">{{ membro.nome ?: 'Sem nome na API' }}</span>
                                <span class="pl-mono">RNP {{ membro.rnp }}</span>
                            </div>
                            <div class="fn">
                                {# qut_funcao é texto livre e qut_tipo é o campo estruturado. Quando a
                                   API manda os dois, o texto já diz o que a marca diria — repetir só
                                   ocuparia a linha. A marca aparece quando é o único que informa. #}
                                {% if membro.funcao %}
                                    {{ membro.funcao }}
                                {% elseif membro.responsavel %}
                                    Responsável técnico
                                {% else %}
                                    Sem função informada
                                {% endif %}
                            </div>
                            {% if membro.vigente %}
                                <span class="pl-pill ok" title="Vínculo vigente: o acervo deste profissional conta para a empresa.">
                                    <span class="pd" aria-hidden="true"></span>Vínculo vigente
                                </span>
                            {% else %}
                                <span class="pl-pill neutral" title="Vínculo encerrado: o acervo deste profissional não conta para a empresa.">
                                    <span class="pd" aria-hidden="true"></span>Encerrado em {{ membro.dt_fim }}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    {# ---------------------------------------------------------------- aba 3: a privacidade

        "Quem vê o quê" virou "Privacidade", como no perfil do profissional. Esta aba governa a
        exposição de cada item DESTE PERFIL; a tela /privacidade governa a CONTA. O quadro ao lado
        é a ponte entre as duas, para que o mesmo nome em dois lugares não vire dúvida. #}
    {% if p.eh_dono %}
        <div class="pl-seg-painel" id="privacidade">
            <div class="pl-cols">
                <div class="pl-stack">
                    {#  Painel de controle do titular. Sem a guarda, quem abre /perfil/{id} de outra
                        empresa veria um formulário que mudaria a visibilidade da própria conta ao
                        ser enviado. #}
                    <section class="pl-card">
                        <div class="pl-linha-titulo">
                            <h2 class="pl-secao">Privacidade</h2>
                            {{ ui.info('Como a visibilidade funciona',
                                'Cada item tem o seu próprio nível, e o padrão de todos é "Só eu". A escolha é conferida toda vez que alguém lê o perfil, inclusive na compatibilização: um documento fechado continua sustentando a aderência sem ser identificado.') }}
                        </div>
                        <p class="pl-nota">
                            Quem vê cada item do perfil da empresa. Nada fica visível sem você
                            escolher, e o padrão de tudo é <strong>Só eu</strong>.
                        </p>

                        {#  A linha do mockup (tela 03 de prolink-profissional.html): o item à esquerda, com
                            uma segunda linha dizendo o que ele é, e o controle à direita. O interruptor do
                            mockup tem duas posições e o nível tem três, então o controle continua sendo o
                            <select>, escrito à mão para caber a segunda linha. O par `for`/`id` continua
                            ligado e a descrição entra por aria-describedby. #}
                        {% set descricao_do_campo = {
                            'EMAIL':    'Contato da conta',
                            'TELEFONE': 'Contato da conta',
                            'RESUMO':   'Texto escrito pela empresa'
                        } %}

                        <form method="post" action="{{ app_url }}/perfil/visibilidade">
                            {{ form.csrf() }}

                            <fieldset class="pl-vis">
                                <legend class="pl-legenda">Dados do perfil</legend>
                                {% for campo in p.campos_do_perfil %}
                                    {% set chave = 'PERFIL:-:' ~ campo %}
                                    {% set id = 'vis-campo-' ~ loop.index %}
                                    <div class="ln">
                                        <div class="tx">
                                            <label class="vt" for="{{ id }}">{{ campo|rotulo_campo }}</label>
                                            <span class="vs" id="{{ id }}-ajuda">{{ descricao_do_campo[campo]|default('Dado do perfil da empresa') }}</span>
                                        </div>
                                        <select class="form-select" name="nivel[{{ chave }}]" id="{{ id }}"
                                                aria-label="Quem vê {{ campo|rotulo_campo }}"
                                                aria-describedby="{{ id }}-ajuda">
                                            {% for valor, texto in niveis_possiveis %}
                                                <option value="{{ valor }}"{% if p.niveis[chave]|default('PRIVADO') == valor %} selected{% endif %}>{{ texto }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endfor %}
                            </fieldset>

                            {% if p.arts is not empty %}
                                <fieldset class="pl-vis">
                                    <legend class="pl-legenda">Cada ART do acervo, uma a uma</legend>
                                    {% if tem_cat %}
                                        <p class="pl-nota pl-vis-nota">Quem vê uma ART vê também a CAT que a certifica. Fechar a ART fecha a certidão junto.</p>
                                    {% endif %}
                                    {% for art in p.arts %}
                                        {% set chave = 'ART:' ~ art.id ~ ':-' %}
                                        {% set id = 'vis-art-' ~ art.id %}
                                        <div class="ln">
                                            <div class="tx">
                                                <label class="vt unidade" for="{{ id }}">
                                                    ART {{ art.numero }}
                                                    {% if art.selo_confere %}
                                                        <svg class="pl-mark" role="img" aria-label="Conferida na API do CREA-AM"><use href="#pl-sym-seal"/></svg>
                                                    {% endif %}
                                                </label>
                                                <span class="vs" id="{{ id }}-ajuda">{{ art.objeto }}{% if art.contratante %} · {{ art.contratante }}{% endif %}</span>
                                            </div>
                                            <select class="form-select" name="nivel[{{ chave }}]" id="{{ id }}"
                                                    aria-describedby="{{ id }}-ajuda">
                                                {% for valor, texto in niveis_possiveis %}
                                                    <option value="{{ valor }}"{% if p.niveis[chave]|default('PRIVADO') == valor %} selected{% endif %}>{{ texto }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    {% endfor %}
                                </fieldset>
                            {% endif %}

                            <div class="pl-acoes-form">{{ form.botao('Salvar visibilidade') }}</div>
                        </form>
                    </section>
                </div>

                <div class="pl-stack">
                    <section class="pl-card">
                        <div class="pl-linha-titulo">
                            <h2 class="pl-secao">Conta e dados</h2>
                        </div>
                        <p class="pl-nota">
                            Esta aba decide quem enxerga cada item <strong>deste perfil</strong>. O que
                            a plataforma guarda sobre a <strong>sua conta</strong> fica em outra tela:
                            consentimentos com data, sessões abertas, exportação em JSON e exclusão da
                            conta.
                        </p>
                        <a class="pl-btn" href="{{ app_url }}/privacidade">Abrir conta e dados</a>
                    </section>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
{#  As abas funcionam sem este arquivo: o painel endereçado abre por `:target` em CSS puro. Ele
    acrescenta o segmento aceso na carga direta de /perfil#quadro, o padrão de abas com seta e
    aria-selected, e a página parada ao trocar de aba. Arquivo externo, e não script embutido,
    porque a CSP recusa inline. #}
<script src="{{ url_assets }}/js/perfil-abas.js?v={{ assets_v }}" defer></script>
<script src="{{ url_assets }}/js/atualizar-acervo.js?v={{ assets_v }}" defer></script>
{% endblock %}
