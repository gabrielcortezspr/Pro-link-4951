{% extends 'layout/base.html.twig' %}

{% block titulo %}Pro-Link · capacidade técnica comprovada{% endblock %}

{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
{% set u = usuario() %}

<div class="pl-abertura">
    <h1>Capacidade técnica comprovada, não autodeclarada</h1>
    <p class="ld">
        O Pro-Link liga quem precisa de um serviço técnico a quem já provou, em ART e CAT
        registradas no CREA-AM, que sabe fazer aquilo.
    </p>
    <div class="ac">
        <a class="pl-cta" href="{{ app_url }}/demandas/abertas">Ver demandas abertas</a>
        {% if u %}
            <a class="pl-btn lg" href="{{ app_url }}/perfil">Meu perfil</a>
        {% else %}
            <a class="pl-btn lg" href="{{ app_url }}/cadastro">Criar conta</a>
        {% endif %}
    </div>
</div>
{% endblock %}
