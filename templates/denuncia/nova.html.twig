{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}
{% import 'layout/_ui.html.twig' as ui %}

{% block titulo %}Registrar denúncia · Pro-Link{% endblock %}

{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
<div class="pl-head">
    <div class="tit">
        <div class="pl-linha-titulo">
            <h1>Registrar denúncia</h1>
            {{ ui.info('O que acontece depois',
                'A denúncia entra na fila de moderação e é apurada por um administrador, que pode advertir, bloquear a conta, remover o conteúdo ou considerá-la improcedente. Denúncia genérica, sem alvo ou contexto vinculado, não é permitida.') }}
        </div>
    </div>
</div>

{% if aviso is defined and aviso %}
    <div class="alert alert-danger" role="alert">{{ aviso }}</div>
{% endif %}

<form method="post" action="{{ app_url }}/denuncias" class="pl-card">
    {{ form.csrf() }}
    <input type="hidden" name="entidade" value="{{ entidade }}">
    <input type="hidden" name="alvo_id" value="{{ alvo_id }}">

    <div class="pl-alvo">
        <p class="rot">Alvo da denúncia</p>
        <p class="vl">{{ alvo_rotulo }}</p>
    </div>

    {{ form.selecao('tipo', 'Tipo de denúncia', tipos, valores.tipo|default(''), erros.tipo|default(null), {required: true}) }}

    {{ form.area('descricao', 'Descrição', valores.descricao|default(''), erros.descricao|default(null), {required: true, rows: 5}, 'Descreva o ocorrido com o máximo de contexto possível.') }}

    {{ form.campo('evidencia', 'Evidência (link ou referência)', 'text', valores.evidencia|default(''), erros.evidencia|default(null), {}, 'Opcional. Informe um link ou a referência de onde o ocorrido pode ser conferido.') }}

    {#  Consequência da ação, no momento da ação: quem denuncia fica identificado na trilha. Isso
        não é explicação de funcionamento, é o que a pessoa precisa saber antes de enviar. #}
    <p class="pl-nota mb-0">
        Esta ação é registrada na trilha de auditoria com autor, alvo e data e hora.
    </p>

    <div class="pl-acoes-form">
        {{ form.botao('Enviar denúncia') }}
        <a class="pl-btn ghost" href="{{ app_url }}">Cancelar</a>
    </div>
</form>
{% endblock %}
