{% extends 'layout/base.html.twig' %}

{% block titulo %}Erro {{ codigo }} · Pro-Link{% endblock %}

{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
<div class="pl-card pl-vazio">
    <p class="pl-erro-cod">{{ codigo }}</p>
    <p class="t">{{ mensagem }}</p>
    <div class="a">
        {% if codigo == 401 %}
            <a class="pl-cta" href="{{ app_url }}/login">Entrar</a>
        {% endif %}
        <a class="pl-btn" href="{{ app_url }}">Voltar ao início</a>
    </div>
</div>
{% endblock %}
