{% extends 'layout/base.html.twig' %}

{% block titulo %}Erro {{ codigo }} — Pro-Link{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center py-5">
            <p class="display-6 mb-1">{{ codigo }}</p>
            <p class="text-body-secondary">{{ mensagem }}</p>
            <a class="btn btn-outline-secondary mt-3" href="{{ app_url }}">Voltar ao início</a>
        </div>
    </div>
{% endblock %}
