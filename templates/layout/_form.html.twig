{#
  Macros de formulário. Acessibilidade embutida (edital 12.1): todo campo tem <label for>,
  o erro é ligado ao campo por aria-describedby, e o estado inválido usa aria-invalid.

  Uso:
    {% import 'layout/_form.html.twig' as form %}
    <form method="post">
      {{ form.csrf() }}
      {{ form.campo('email', 'E-mail', 'email', valores.email|default(''), erros.email|default(null), {autocomplete: 'email', required: true}) }}
      {{ form.senha('senha', 'Senha', erros.senha|default(null)) }}
      {{ form.selecao('perfil', 'Perfil', {'PROFISSIONAL': 'Profissional', 'EMPRESA': 'Empresa'}, valores.perfil|default(''), erros.perfil|default(null)) }}
      {{ form.caixa('aceite', 'Li e aceito os Termos de Uso', valores.aceite|default(false), erros.aceite|default(null)) }}
      {{ form.botao('Entrar') }}
    </form>
#}

{% macro csrf() %}
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
{% endmacro %}

{% macro campo(nome, rotulo, tipo = 'text', valor = '', erro = null, attrs = {}, ajuda = null) %}
    {% set id = 'campo-' ~ nome %}
    <div class="mb-3">
        <label for="{{ id }}" class="form-label">{{ rotulo }}{% if attrs.required|default(false) %} <span class="text-danger" aria-hidden="true">*</span>{% endif %}</label>
        <input type="{{ tipo }}" name="{{ nome }}" id="{{ id }}" value="{{ valor }}"
               class="form-control{% if erro %} is-invalid{% endif %}"
               {% if erro %}aria-invalid="true" aria-describedby="{{ id }}-erro"{% elseif ajuda %}aria-describedby="{{ id }}-ajuda"{% endif %}
               {% for k, v in attrs %}{% if v is same as(true) %}{{ k }} {% elseif v is not same as(false) %}{{ k }}="{{ v }}" {% endif %}{% endfor %}>
        {% if erro %}<div id="{{ id }}-erro" class="invalid-feedback">{{ erro }}</div>{% endif %}
        {% if ajuda and not erro %}<div id="{{ id }}-ajuda" class="form-text">{{ ajuda }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro senha(nome, rotulo, erro = null, attrs = {}, ajuda = null) %}
    {{ _self.campo(nome, rotulo, 'password', '', erro, {autocomplete: 'current-password', required: true}|merge(attrs), ajuda) }}
{% endmacro %}

{% macro area(nome, rotulo, valor = '', erro = null, attrs = {}, ajuda = null) %}
    {% set id = 'campo-' ~ nome %}
    <div class="mb-3">
        <label for="{{ id }}" class="form-label">{{ rotulo }}{% if attrs.required|default(false) %} <span class="text-danger" aria-hidden="true">*</span>{% endif %}</label>
        {#  `rows` e `required` saem tratados acima; o resto de `attrs` passa adiante igual ao que
            a macro `campo` já faz. Sem isso não havia como pôr `maxlength` num textarea, e o
            limite do servidor só aparecia depois de a pessoa perder o texto escrito. #}
        <textarea name="{{ nome }}" id="{{ id }}" rows="{{ attrs.rows|default(4) }}"
                  class="form-control{% if erro %} is-invalid{% endif %}"
                  {% if erro %}aria-invalid="true" aria-describedby="{{ id }}-erro"{% elseif ajuda %}aria-describedby="{{ id }}-ajuda"{% endif %}
                  {% if attrs.required|default(false) %}required{% endif %}
                  {% for k, v in attrs %}{% if k not in ['rows', 'required'] %}{% if v is same as(true) %}{{ k }} {% elseif v is not same as(false) %}{{ k }}="{{ v }}" {% endif %}{% endif %}{% endfor %}>{{ valor }}</textarea>
        {% if erro %}<div id="{{ id }}-erro" class="invalid-feedback">{{ erro }}</div>{% endif %}
        {% if ajuda and not erro %}<div id="{{ id }}-ajuda" class="form-text">{{ ajuda }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro selecao(nome, rotulo, opcoes, valor = '', erro = null, attrs = {}, vazio = 'Selecione…') %}
    {% set id = 'campo-' ~ nome %}
    <div class="mb-3">
        <label for="{{ id }}" class="form-label">{{ rotulo }}{% if attrs.required|default(false) %} <span class="text-danger" aria-hidden="true">*</span>{% endif %}</label>
        <select name="{{ nome }}" id="{{ id }}" class="form-select{% if erro %} is-invalid{% endif %}"
                {% if erro %}aria-invalid="true" aria-describedby="{{ id }}-erro"{% endif %}
                {% if attrs.required|default(false) %}required{% endif %}>
            {% if vazio %}<option value="">{{ vazio }}</option>{% endif %}
            {% for chave, texto in opcoes %}
                <option value="{{ chave }}"{% if chave == valor %} selected{% endif %}>{{ texto }}</option>
            {% endfor %}
        </select>
        {% if erro %}<div id="{{ id }}-erro" class="invalid-feedback">{{ erro }}</div>{% endif %}
    </div>
{% endmacro %}

{#
    Caixa de seleção. O rótulo é **texto**, sempre escapado.

    `link` e `sufixo` existem porque os dois aceites de termo precisam de uma âncora dentro do
    rótulo, e a solução anterior era passar HTML montado por concatenação e imprimi-lo com `|raw`.
    Funcionava, e o preço era que `ter_versao` — coluna de `sis_termos`, portanto dado — entrava
    cru no HTML da tela de cadastro. Ninguém ia explorar isso hoje; o problema é que a próxima
    pessoa a chamar este macro com um rótulo vindo do banco não teria como saber.

    Assim o macro não tem mais como emitir HTML que não seja dele:
      link   {url, texto} — vira <a target="_blank" rel="noopener">
      sufixo texto curto depois do link, tipo "(versão 1.0)"
#}
{% macro caixa(nome, rotulo, marcado = false, erro = null, attrs = {}, link = null, sufixo = null) %}
    {% set id = 'campo-' ~ nome %}
    <div class="mb-3 form-check">
        <input type="checkbox" name="{{ nome }}" id="{{ id }}" value="1"
               class="form-check-input{% if erro %} is-invalid{% endif %}"
               {% if marcado %}checked{% endif %}
               {% if erro %}aria-invalid="true" aria-describedby="{{ id }}-erro"{% endif %}
               {% if attrs.required|default(false) %}required{% endif %}>
        <label for="{{ id }}" class="form-check-label">
            {{- rotulo -}}
            {%- if link %} <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.texto }}</a>{% endif -%}
            {%- if sufixo %} {{ sufixo }}{% endif -%}
        </label>
        {% if erro %}<div id="{{ id }}-erro" class="invalid-feedback">{{ erro }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro botao(texto, tipo = 'primary', attrs = {}) %}
    <button type="submit" class="btn btn-{{ tipo }}"{% for k, v in attrs %} {{ k }}="{{ v }}"{% endfor %}>{{ texto }}</button>
{% endmacro %}
