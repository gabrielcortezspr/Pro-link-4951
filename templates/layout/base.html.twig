<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titulo %}Pro-Link{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ url_assets }}/css/prolink.css">
</head>
<body class="d-flex flex-column min-vh-100">

<a href="#conteudo" class="visually-hidden-focusable p-2">Pular para o conteúdo</a>

<header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ app_url }}">Pro-Link</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#menu" aria-controls="menu" aria-expanded="false"
                    aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    {% block menu %}{% endblock %}
                    {% set u = usuario() %}
                    {% if u %}
                        {% if u.perfil == 'ADMIN' %}<li class="nav-item"><a class="nav-link" href="{{ app_url }}/admin">Administração</a></li>{% endif %}
                        <li class="nav-item"><span class="nav-link text-body-secondary">{{ u.nome }}</span></li>
                        <li class="nav-item"><a class="nav-link" href="{{ app_url }}/sair">Sair</a></li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ app_url }}/login">Entrar</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ app_url }}/cadastro">Cadastrar</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>

<main id="conteudo" class="container flex-grow-1 py-4">
    {% for f in flashes() %}
        <div class="alert alert-{{ f.tipo }} alert-dismissible" role="alert">
            {{ f.texto }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    {% endfor %}
    {% block conteudo %}{% endblock %}
</main>

<footer class="border-top py-3 mt-auto">
    <div class="container small text-body-secondary">
        Pro-Link · Desafio CREA Pro-Link · II CENATEC 2026 · Equipe 49/51<br>
        Dados fictícios fornecidos pela organização. A correspondência entre perfil e demanda é
        apenas indicativa e não constitui ranking, certificação ou recomendação institucional.
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
