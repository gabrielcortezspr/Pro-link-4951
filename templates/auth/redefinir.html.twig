{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}

{#  Definir nova senha, na mesma família da entrada (ver auth/login.html.twig). O painel esquerdo
    carrega a consequência da ação, que é a única coisa que alguém precisa saber antes de
    confirmar aqui. O formulário não mudou. #}

{% block titulo %}Nova senha · Pro-Link{% endblock %}

{% block classe_main %}pl-ent{% endblock %}

{% block conteudo %}
<div class="pl-ent-grade">

    <section class="pl-ent-lado">
        <span class="pl-ent-olho">Acesso à conta</span>
        <p class="tese">Senha nova, sessões <span class="v">zeradas</span>.</p>
        <p class="sub">
            Ao confirmar, todas as sessões abertas nesta conta são encerradas, inclusive as de
            outros aparelhos. Entrar de novo é o que prova que a credencial é sua.
        </p>

        <p class="pl-ent-selo">
            <svg class="pl-ent-escudo" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path class="corpo" d="M12 2l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V5z"/><path class="marca" d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            Cada perfil é verificado pela API oficial do CREA-AM
        </p>
    </section>

    <div class="pl-ent-painel">
        <div class="pl-ent-caixa">
            <h1>Definir nova senha</h1>
            <p class="pl-ent-ld">Ao confirmar, todas as suas sessões abertas serão encerradas.</p>

            {% if aviso|default(null) %}<div class="alert alert-danger" role="alert">{{ aviso }}</div>{% endif %}

            <form method="post" action="{{ app_url }}/redefinir-senha/{{ token }}" novalidate>
                {{ form.csrf() }}

                {{ form.senha('senha', 'Nova senha', erros.senha|default(null),
                    {autocomplete: 'new-password'}, 'Pelo menos 12 caracteres.') }}

                {{ form.senha('senha_confirmacao', 'Repita a nova senha',
                    erros.senha_confirmacao|default(null), {autocomplete: 'new-password'}) }}

                {{ form.botao('Salvar senha') }}
            </form>

            <p class="pl-ent-links"><a href="{{ app_url }}/login">Voltar para a entrada</a></p>
        </div>
    </div>

</div>
{% endblock %}
