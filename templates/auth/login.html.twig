{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}

{% block titulo %}Entrar · Pro-Link{% endblock %}

{#  Entrada: um cartão centrado é a forma esperada desta tela, e aqui a moldura vazia é
    composição, não coluna estreita esquecida no meio da página. #}
{% block classe_main %}pl-wrap leitura{% endblock %}

{% block conteudo %}
<div class="pl-auth">
    <div class="pl-card">
        <h1 class="pl-secao mb-3">Entrar</h1>

        {% if aviso|default(null) %}<div class="alert alert-danger" role="alert">{{ aviso }}</div>{% endif %}

        <form method="post" action="{{ app_url }}/login" novalidate>
            {{ form.csrf() }}

            {{ form.campo('email', 'E-mail', 'email',
                valores.email|default(''), erros.email|default(null),
                {autocomplete: 'email', required: true}) }}

            {{ form.senha('senha', 'Senha', erros.senha|default(null)) }}

            {{ form.botao('Entrar') }}
        </form>
    </div>

    <p class="pl-auth-links">
        <a href="{{ app_url }}/recuperar-senha">Esqueci minha senha</a>
        <span class="pl-sep" aria-hidden="true"></span>
        <a href="{{ app_url }}/cadastro">Criar uma conta</a>
    </p>
</div>
{% endblock %}
