{% extends 'layout/base.html.twig' %}
{% import 'layout/_form.html.twig' as form %}

{#  Recuperar senha, na mesma família da entrada (ver auth/login.html.twig). Painel curto: aqui a
    tela tem uma coisa a dizer, e é a mesma frase que o formulário já diz, então a lista de itens
    do lado esquerdo não existe. O formulário não mudou. #}

{% block titulo %}Recuperar senha · Pro-Link{% endblock %}

{% block classe_main %}pl-ent{% endblock %}

{% block conteudo %}
<div class="pl-ent-grade">

    <section class="pl-ent-lado">
        <span class="pl-ent-olho">Acesso à conta</span>
        <p class="tese">A conta continua <span class="v">sua</span>.</p>
        <p class="sub">
            A plataforma nunca confirma se um endereço tem conta aqui: a resposta desta tela é a
            mesma nos dois casos, e quem tem conta recebe o link no e-mail.
        </p>

        <p class="pl-ent-selo">
            <svg class="pl-ent-escudo" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path class="corpo" d="M12 2l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V5z"/><path class="marca" d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            Cada perfil é verificado pela API oficial do CREA-AM
        </p>
    </section>

    <div class="pl-ent-painel">
        <div class="pl-ent-caixa">
            <h1>Recuperar senha</h1>
            <p class="pl-ent-ld">
                Informe o e-mail da conta. Se existir conta com esse endereço, enviamos um link de
                redefinição.
            </p>

            <form method="post" action="{{ app_url }}/recuperar-senha" novalidate>
                {{ form.csrf() }}

                {{ form.campo('email', 'E-mail', 'email',
                    valores.email|default(''), erros.email|default(null),
                    {autocomplete: 'email', required: true}) }}

                {{ form.botao('Enviar link') }}
            </form>

            <p class="pl-ent-links"><a href="{{ app_url }}/login">Voltar para a entrada</a></p>
        </div>
    </div>

</div>
{% endblock %}
