{% extends 'admin/_layout.html.twig' %}

{% block titulo %}Administração · Pro-Link{% endblock %}
{% block titulo_painel %}Visão geral{% endblock %}

{% block painel %}
    <div class="row g-3">
        {% for rotulo in ['Usuários', 'Demandas ativas', 'Manifestações', 'Denúncias abertas'] %}
            <div class="col-6 col-lg-3">
                <div class="pl-kpi">
                    <div class="lab">{{ rotulo }}</div>
                    {# Indicador ainda não medido. Um traço no tamanho do número lia como valor,
                       e leitor de tela não lê traço nenhum: aqui o estado está escrito. #}
                    <div class="val vazio">Não medido</div>
                </div>
            </div>
        {% endfor %}
    </div>

    <p class="pl-nota mt-3 mb-0">
        Os indicadores entram em 15/09. Demandas e manifestações dependem da RF04 e da RF05.
    </p>
{% endblock %}
