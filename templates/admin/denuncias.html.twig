{% extends 'admin/_layout.html.twig' %}

{% block titulo %}Denúncias · Pro-Link{% endblock %}
{% block titulo_painel %}Denúncias{% endblock %}

{% block painel %}

    {# Vocabulário fixo de status: a aba fala no plural, a pílula da linha no singular, e a cor
       é fixa por estado (docs/design.md). Nunca inventar rótulo novo aqui. #}
    {% set abas   = {'PENDENTE': 'Pendentes', 'EM_ANALISE': 'Em análise', 'RESOLVIDA': 'Resolvidas'} %}
    {% set estado = {'PENDENTE': 'Pendente',  'EM_ANALISE': 'Em análise', 'RESOLVIDA': 'Resolvida'} %}
    {% set cores  = {'PENDENTE': 'warn',      'EM_ANALISE': 'neutral',    'RESOLVIDA': 'ok'} %}

    <nav class="mb-3 d-flex flex-wrap gap-2" aria-label="Filtrar por situação">
        <a class="pl-btn sm{% if situacao is null %} active{% endif %}"
           href="{{ app_url }}/admin/denuncias"
           {% if situacao is null %}aria-current="page"{% endif %}>Todas</a>
        {% for s in situacoes %}
            <a class="pl-btn sm{% if situacao == s %} active{% endif %}"
               href="{{ app_url }}/admin/denuncias?situacao={{ s }}"
               {% if situacao == s %}aria-current="page"{% endif %}>{{ abas[s]|default(s) }}</a>
        {% endfor %}
    </nav>

    <div class="pl-card">
        <div class="table-responsive">
            <table class="pl-table">
                <thead>
                    <tr>
                        <th>Alvo</th>
                        <th>Tipo</th>
                        <th>Autor</th>
                        <th>Recebida</th>
                        <th>Situação</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for d in fila %}
                    <tr>
                        <td>
                            <span class="lin-tt">{{ d.alvo_nome|default(d.den_entidade|rotulo_entidade ~ ' nº ' ~ d.den_entidade_id) }}</span>
                            {% if d.alvo_nome %}<span class="lin-sub">Conta</span>{% endif %}
                        </td>
                        <td>{{ tipos[d.den_tipo]|default(d.den_tipo) }}</td>
                        <td>{{ d.autor_nome }}</td>
                        <td class="mono">{{ d.den_dt_registro|date('d/m/Y H:i') }}</td>
                        <td>
                            <span class="pl-pill {{ cores[d.den_situacao]|default('neutral') }}">
                                <span class="pd"></span>{{ estado[d.den_situacao]|default(d.den_situacao) }}
                            </span>
                        </td>
                        {# Uma ação por linha: as demais moram no detalhe (docs/design.md). #}
                        <td class="text-end">
                            <a class="pl-btn sm" href="{{ app_url }}/admin/denuncias/{{ d.den_id }}">Ver</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="pl-vazio">
                                <p class="t">Nenhuma denúncia nesta situação</p>
                                <p class="s">
                                    A fila fica vazia quando não há nada pendente de apuração neste
                                    recorte. Troque a aba para ver as demais.
                                </p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
